NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only
LLM_PROVIDER=gemini               # gemini | openai | anthropic
# LLM_MODEL=gemini-2.5-flash      # optional model override
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MAX_OUTPUT_TOKENS=8192        # optional, default 8192
LLM_TWO_PASS=false                # optional, default false (set true for 2-pass generate + refine)
LLM_REFINE_ENABLED=true           # optional, default true (controls /api/refine and 2nd pass)
NEXT_PUBLIC_BASIC_UI=false        # optional, default false (set true for plain test UI)
TOKEN_ENCRYPTION_KEY=             # 32-byte base64  (generate: openssl rand -base64 32)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_MOCK=false                      # optional, dev/test only: simulate X OAuth & direct post without credits
NEXT_PUBLIC_APP_URL=http://localhost:3000
